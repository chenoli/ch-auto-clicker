{
  "name": "ch-clicker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "visual:refs": "tsx ui/tests/visual/capture-references.ts",
    "tokens": "tsx tools/gen-tokens/gen-tokens.ts",
    "tokens:check": "tsx tools/gen-tokens/gen-tokens.ts --check"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@tauri-apps/api": "^2.12.1",
    "i18next": "^26.4.2",
    "i18next-icu": "^2.4.4",
    "intl-messageformat": "^12.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/utils": "^8.71.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "culori": "^4.0.2",
    "eslint": "^10.12.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
