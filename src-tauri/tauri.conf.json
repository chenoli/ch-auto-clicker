{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CH Clicker",
  "mainBinaryName": "ch-clicker",
  "version": "0.1.0",
  "identifier": "br.com.chenoli.clicker",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "CH. Clicker",
        "url": "index.html",
        "width": 420,
        "height": 640,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "backgroundColor": "#141412",
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: chcap: http://chcap.localhost; connect-src ipc: http://ipc.localhost chcap: http://chcap.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Chenoli Labs",
    "copyright": "© 2026 Chenoli Labs",
    "category": "Utility",
    "shortDescription": "Auto clicker de precisão para Windows",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "languages": ["PortugueseBR", "English", "Spanish"]
      },
      "wix": {
        "language": ["pt-BR", "en-US"]
      }
    }
  }
}
