{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CH Auto Clicker",
  "mainBinaryName": "ch-auto-clicker",
  "version": "0.1.0",
  "identifier": "br.com.chenoli.clicker",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "CH Auto Clicker",
        "url": "index.html",
        "width": 420,
        "height": 640,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "backgroundColor": "#141412",
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: chcap: http://chcap.localhost; connect-src ipc: http://ipc.localhost chcap: http://chcap.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Chenoli Labs",
    "copyright": "© 2026 Chenoli Labs",
    "category": "Utility",
    "shortDescription": "Precision auto clicker for Windows",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh",
        "languages": ["PortugueseBR", "English", "Spanish"],
        "displayLanguageSelector": true
      },
      "wix": {
        "language": ["pt-BR", "en-US"]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFRTEyQzU1M0NBOURERTkKUldUcDNhazhWU3pocnRkcHJsUy81dXNOL2l6elE4Umx0NHpNaXNtMU1QeHdEblZnNldCV010TjAK",
      "endpoints": ["https://github.com/chenoli/ch-auto-clicker/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
