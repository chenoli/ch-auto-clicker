{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window, the variation editor, the capture overlays, the HUD and the tray menu.",
  "windows": ["main", "variation", "overlay-*", "hud", "tray-menu"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-set-focus"
  ]
}
